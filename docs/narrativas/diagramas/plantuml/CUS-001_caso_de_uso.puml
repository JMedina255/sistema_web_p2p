/'
  Diagrama: Diagrama de Caso de Uso — CUS-001: Iniciar sesión institucional con 2FA
  Proyecto: Sistema Web P2P de Mentorías Académicas — EPIS-UPT
  Estándar: UML 2.5
'/
@startuml
title CUS-001 — Iniciar sesión institucional con 2FA
top to bottom direction
skinparam nodesep 36
skinparam ranksep 45
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam fontSize 11

skinparam actor {
  BorderColor #1C2A59
  BorderThickness 1.2
  FontColor #1C2A59
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #1C2A59
  BorderThickness 1.2
  FontColor #1C2A59
  ArrowColor #1C2A59
  ArrowFontColor #1C2A59
  ArrowFontSize 10
}

actor "Estudiante Mentoreado" as Mentoreado #EBF3FB
actor "Estudiante Mentor" as Mentor #EBF3FB
actor "Administrador Institucional" as Admin #FEF9C3
actor "Servicio de Correo\nInstitucional" as Correo #FFF1F2
actor "Servicio de Identidad\nde Google" as Google #FFF1F2

caption Límite del sistema: Sistema Web P2P - EPIS-UPT
rectangle {
  usecase "CUS-001: Iniciar sesión institucional\ncon 2FA" as CUS01
  usecase "Solicitar y verificar\ncódigo temporal (OTP)" as UC_OTP
  usecase "Autenticar con cuenta\ninstitucional de Google" as UC_Google
  usecase "Registrar consentimiento informado\n(Ley N.° 29733)" as UC_Consent
}

Mentoreado -down- CUS01
Mentor -down- CUS01
Admin -down- CUS01

CUS01 <.down. UC_OTP : <<extend>>\n[acceso por correo]
CUS01 <.down. UC_Google : <<extend>>\n[si está disponible]
CUS01 <.down. UC_Consent : <<extend>>\n[sin consentimiento vigente]

UC_OTP -down- Correo
UC_Google -down- Google

legend bottom
  Validación manual con cuenta institucional de Google pendiente.
endlegend

@enduml
