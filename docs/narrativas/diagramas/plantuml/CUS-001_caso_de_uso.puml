/'
  Diagrama: Diagrama de Caso de Uso — CUS-001: Iniciar sesión institucional con 2FA
  Proyecto: Sistema Web P2P con algoritmo de recomendación para la personalización de mentorías académicas en la EPIS-UPT
  Estándar: UML 2.5
'/
@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam fontSize 11

skinparam actor {
  BorderColor #1C2A59
  BorderThickness 1.2
  FontColor #1C2A59
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #1C2A59
  BorderThickness 1.2
  FontColor #1C2A59
  ArrowColor #1C2A59
  ArrowFontColor #1C2A59
  ArrowFontSize 10
}

actor "Estudiante Mentoreado" as Mentoreado #EBF3FB
actor "Estudiante Mentor" as Mentor #EBF3FB
actor "Administrador Institucional" as Admin #FEF9C3

actor "Servicio de Correo\nInstitucional (SMTP)" as Correo #FFF1F2
actor "Servicio de Identidad\nGoogle Workspace" as Google #FFF1F2

rectangle "Sistema Web P2P — EPIS-UPT" {
  usecase "CUS-001: Iniciar sesión institucional\ncon 2FA" as CUS01
  usecase "Verificar código de acceso\ntemporal (OTP)" as UC_OTP
  usecase "Formalizar consentimiento informado\nde privacidad (Ley N° 29733)" as UC_Consent
  usecase "Autenticar mediante\nGoogle Workspace UPT" as UC_Google
}

Mentoreado --> CUS01
Mentor --> CUS01
Admin --> CUS01

CUS01 .> UC_OTP : <<include>>
CUS01 .> UC_Consent : <<include>>
UC_Google .> CUS01 : <<extend>>

UC_OTP --> Correo
UC_Google --> Google

@enduml
