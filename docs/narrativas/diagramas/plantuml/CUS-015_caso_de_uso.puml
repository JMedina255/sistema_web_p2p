@startuml
' CUS-015 — Configurar parámetros del algoritmo de recomendación
' Estado: Pendiente: interfaz de parametrización no identificada
' Fuente: catálogo consolidado DOC-H02, línea base 044d2a8.
left to right direction
title CUS-015 — Configurar parámetros del algoritmo de recomendación\nPropuesta funcional — implementación pendiente
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam actor {
  BorderColor #1C2A59
  FontColor #1C2A59
}
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #1C2A59
  FontColor #1C2A59
}
skinparam rectangle {
  BorderColor #1C2A59
}
actor "Administrador\ninstitucional" as A0
rectangle "Sistema Web P2P — EPIS-UPT" {
  usecase "CUS-015 — Configurar\nparámetros del algoritmo de\nrecomendación" as UC
  usecase "Consultar configuración\nvigente" as U1
  usecase "Validar parámetros y aplicar\ncambios" as U2
  usecase "Restaurar valores aprobados" as U3
  usecase "Comprobar con datos de prueba" as U4
}
A0 -- UC
UC ..> U1 : <<include>>
UC ..> U2 : <<include>>
U3 ..> UC : <<extend>>\n[Solicitud expresa]
U4 ..> UC : <<extend>>\n[Validación previa]
legend right
  Pendiente: interfaz de parametrización no
  identificada
endlegend
@enduml
