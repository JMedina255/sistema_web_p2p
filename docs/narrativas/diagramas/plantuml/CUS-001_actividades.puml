/'
  Diagrama: Diagrama de Actividades — CUS-001: Iniciar sesión institucional con 2FA
  Proyecto: Sistema Web P2P de Mentorías Académicas — EPIS-UPT
  Estándar: UML 2.5
'/
@startuml
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam fontSize 11
skinparam defaultTextAlignment center

skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #1C2A59
  BorderThickness 1.2
  FontColor #1C2A59
  ArrowColor #1C2A59
  ArrowFontColor #1C2A59
  ArrowFontSize 10
}

skinparam activityDiamond {
  BackgroundColor #FEF9C3
  BorderColor #B99451
  FontColor #1C2A59
  FontSize 10
}

skinparam swimlane {
  BorderColor #1C2A59
  BorderThickness 1.5
  TitleBackgroundColor #1C2A59
  TitleFontColor #FFFFFF
  TitleFontSize 12
}

|Usuario|
start
:Accede al sistema y selecciona\n«Iniciar sesión»;

|Sistema Web P2P|
:Muestra acceso por correo institucional\ny, si está disponible, botón oficial de Google;

|Usuario|
if (¿Selecciona Google?) then (Sí)
  :Elige una cuenta en Google;
  |Sistema Web P2P|
  :Valida la identidad y el dominio institucional;
  note right
    [A001] Operación con cuenta real:
    validación manual pendiente
  end note
  if (¿Cuenta institucional válida?) then (No)
    :Muestra rechazo de dominio;\n[E001];
    stop
  endif
else (No, usa OTP)
  :Ingresa el correo y presiona\n«Continuar con Código OTP →»;
  |Sistema Web P2P|
  if (¿Formato y dominio válidos?) then (No)
    :Muestra rechazo de correo;\n[E001];
    stop
  endif
  if (¿Solicitud admitida y correo enviado?) then (No)
    :Muestra espera, límite o indisponibilidad;\n[E002 / E006 / E008];
    stop
  endif
  :Emite código de 6 dígitos por 5 minutos;
  :Muestra destino, contador 05:00,\n«Cambiar correo», reenvío y «Cancelar»;

  |Usuario|
  if (¿Cambia correo o cancela?) then (Sí [A004])
    |Sistema Web P2P|
    :Descarta el formulario visible\ny vuelve al ingreso de correo;
    stop
  endif
  if (¿Solicita reenvío habilitado?) then (Sí [A002])
    |Sistema Web P2P|
    :Invalida el código anterior,\nemite otro y reinicia los contadores;
  endif
  |Usuario|
  :Ingresa 6 dígitos y presiona\n«Verificar y Acceder»;
  |Sistema Web P2P|
  if (¿Código vigente?) then (No)
    :Informa expiración y habilita reenvío;\n[E004];
    stop
  endif
  if (¿Código correcto?) then (No)
    if (¿Quinto intento fallido?) then (Sí)
      :Bloquea definitivamente el desafío;\nsolicita generar un código nuevo [E005];
      stop
    else (No)
      :Informa código incorrecto\ne intentos restantes [E003];
      stop
    endif
  endif
endif

|Sistema Web P2P|
if (¿Consentimiento vigente?) then (Sí [A003])
else (No)
  :Muestra «Consentimiento Informado Digital»;
  |Usuario|
  if (¿Acepta el tratamiento de datos?) then (No)
    :Presiona «🚫 Rechazar y Salir»;
    |Sistema Web P2P|
    :Cierra la sesión y vuelve al acceso [E007];
    stop
  else (Sí)
    :Marca la casilla y presiona\n«✓ Aceptar y Continuar»;
    |Sistema Web P2P|
    :Registra versión y fecha del consentimiento;
  endif
endif

|Sistema Web P2P|
:Emite sesión con vigencia máxima de 8 horas;
:Abre el panel inicial del rol y muestra\n«Cerrar Sesión»;

|Usuario|
if (¿Cierra la sesión?) then (Sí [A005])
  :Presiona «Cerrar Sesión»;
  |Sistema Web P2P|
  :Elimina la sesión del navegador\ny retorna al acceso;
  stop
else (No)
  |Sistema Web P2P|
  :Mantiene el acceso mientras la sesión sea válida;
  stop
endif
@enduml
