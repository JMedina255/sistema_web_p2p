@startuml
' CUS-008 — Gestionar demanda insatisfecha de mentoría
' Estado: Propuesta previamente presentada; pendiente de aprobación explícita
' Fuente: catálogo consolidado DOC-H02, línea base 044d2a8.
left to right direction
title CUS-008 — Gestionar demanda insatisfecha de mentoría\nAlcance parcial o pendiente de verificación
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam actor {
  BorderColor #1C2A59
  FontColor #1C2A59
}
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #1C2A59
  FontColor #1C2A59
}
skinparam rectangle {
  BorderColor #1C2A59
}
actor "Estudiante Mentoreado" as A0
actor "Estudiante Mentor" as A1
rectangle "Sistema Web P2P — EPIS-UPT" {
  usecase "Registrar solicitud" as U1
  usecase "Seleccionar asignatura y tema" as U2
  usecase "Generar folio institucional" as U3
  usecase "Registrar observaciones" as U4
  usecase "Filtrar o actualizar\nsolicitudes" as U5
  usecase "Consultar banco de demanda" as U6
  usecase "Proponer mentoría dirigida" as U7
  usecase "CUS-006 Registrar oferta" as U8
  usecase "Actualizar solicitud a\nATENDIDA" as U9
}
A0 -- U1
A1 -- U6
A1 -- U7
U1 ..> U2 : <<include>>
U1 ..> U3 : <<include>>
U4 ..> U1 : <<extend>>\n[Opcional]
U5 ..> U6 : <<extend>>\n[Por decisión del mentor]
U7 ..> U6 : <<extend>>\n[Solicitud seleccionada]
U7 ..> U8 : <<include>>
U9 ..> U8 : <<extend>>\n[Publicación vinculada exitosa]
legend bottom
  CUS-008 agrupa objetivos independientes.
endlegend
@enduml
