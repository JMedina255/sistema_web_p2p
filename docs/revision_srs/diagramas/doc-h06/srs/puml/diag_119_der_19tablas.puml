  estado : String(30)
  quorumevaluated_at : DateTime(UTC)
  created_at : DateTime(UTC)
}
entity "perfiles_academicos" as perfiles_academicos {
  id_perfil : Integer <<PK>>
  email : String(255)
  codigo_estudiante : String(20)
  nombres : String(100)
  apellidos : String(100)
  ciclo_actual : Integer
  rol_postulacion : String(20)
