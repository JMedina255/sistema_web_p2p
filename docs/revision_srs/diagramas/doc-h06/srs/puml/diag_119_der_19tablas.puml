@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #1C2A59
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam maxMessageSize 260
skinparam dpi 140
title Figura 119. Modelo físico declarado: 19 tablas
entity "asistencias_sesion" as asistencias_sesion {
  id_asistencia : Integer <<PK>>
  id_sesion : Integer
  estudiante_email : String(255)
  asistio : Boolean
  fecha_checkin : DateTime(UTC)
  ip_origen : String(45)
  created_at : DateTime(UTC)
}
entity "tokens_asistencia_activos" as tokens_asistencia_activos {
  id_token : Integer <<PK>>
  id_sesion : Integer
  token : String(64)
  totp_code : String(6)
  expires_at : DateTime(UTC)
  created_at : DateTime(UTC)
}
entity "auth_challenges" as auth_challenges {
  id_challenge : String(64) <<PK>>
  email : String(255)
  code_hash : String(255)
  code_salt : String(64)
  created_at : DateTime(UTC)
  expires_at : DateTime(UTC)
  resend_available_at : DateTime(UTC)
  consumed : Boolean
  attempts : Integer
}
entity "auth_rate_limits" as auth_rate_limits {
  key : String(128) <<PK>>
  count : Integer
  window_expires_at : DateTime(UTC)
  updated_at : DateTime(UTC)
}
entity "bitacoras_pedagogicas" as bitacoras_pedagogicas {
  id_bitacora : Integer <<PK>>
  id_sesion : Integer
  id_mentor : String(255)
  temas_cubiertos : JSON
  observaciones : Text
  nivel_dificultad : String(20)
  hash_firma : String(64)
  horas_declaradas : Float
  visado_administrador : Boolean
  created_at : DateTime(UTC)
}
entity "reservas_cupo" as reservas_cupo {
  id_reserva : Integer <<PK>>
  codigo_reserva : String(20)
  id_sesion : Integer
  estudiante_email : String(255)
  estado : String(30)
  fecha_reserva : DateTime(UTC)
  fecha_ratificacion : DateTime(UTC)
  motivo_cancelacion : Text
  ticket_hash : String(64)
  created_at : DateTime(UTC)
  updated_at : DateTime(UTC)
}
entity "solicitudes_demanda" as solicitudes_demanda {
  id_demanda : Integer <<PK>>
  estudiante_email : String(255)
  id_asignatura : Integer
  id_tema : Integer
  observaciones : Text
  estado : String(20)
  created_at : DateTime(UTC)
}
entity "certificados_horas" as certificados_horas {
  id_certificado : Integer <<PK>>
  id_mentor : String(255)
  codigo_folio : String(50)
  periodo_academico : String(20)
  horas_acreditadas : Float
  hash_firma : String(64)
  estado : String(30)
  created_at : DateTime(UTC)
}
entity "consentimientos_legales" as consentimientos_legales {
  id_consentimiento : Integer <<PK>>
  email : String(255)
  terms_version : String(50)
  accepted : Boolean
  consented_at : DateTime(UTC)
  ip_address : String(45)
  user_agent : Text
}
entity "asignaturas" as asignaturas {
  id_asignatura : Integer <<PK>>
  codigo_curso : String(20)
  nombre_curso : String(150)
  ciclo_plan : Integer
  creditos : Integer
  es_prioritaria : Boolean
  factor_ponderacion : Float
