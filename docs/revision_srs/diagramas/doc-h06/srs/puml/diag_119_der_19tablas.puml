}
entity "usuario_roles" as usuario_roles {
  id_usuario_rol : Integer <<PK>>
  email : String(255)
  id_rol : Integer
  fecha_asignacion : DateTime(UTC)
  asignado_por : String(255)
  activo : Boolean
}
entity "versiones_cronograma" as versiones_cronograma {
  id : Integer <<PK>>
  archivo : String(255)
  franjas : JSON
  creado : DateTime(UTC)
}
entity "cronograma_activo" as cronograma_activo {
  id : Integer <<PK>>
  id_version : Integer
}
entity "encuestas_calidad" as encuestas_calidad {
  id_encuesta : Integer <<PK>>
  id_sesion : Integer
  estudiante_email : String(255)
  calificacion_general : Integer
  dominio_tema : Integer
  claridad_explicacion : Integer
  puntualidad : Integer
  comentarios : Text
  created_at : DateTime(UTC)
}
sesiones_mentoria ||--o{ asistencias_sesion : id_sesion
sesiones_mentoria ||--o| tokens_asistencia_activos : id_sesion
sesiones_mentoria ||--o| bitacoras_pedagogicas : id_sesion
sesiones_mentoria ||--o{ reservas_cupo : id_sesion
asignaturas ||--o{ solicitudes_demanda : id_asignatura
temas_conceptuales ||--o{ solicitudes_demanda : id_tema
asignaturas ||--o{ temas_conceptuales : id_asignatura
asignaturas ||--o{ sesiones_mentoria : id_asignatura
temas_conceptuales ||--o{ sesiones_mentoria : id_tema
roles ||--o{ usuario_roles : id_rol
versiones_cronograma |o--o{ cronograma_activo : id_version
sesiones_mentoria ||--o{ encuestas_calidad : id_sesion
@enduml
