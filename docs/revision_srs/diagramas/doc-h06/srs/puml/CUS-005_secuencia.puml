@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #1C2A59
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam maxMessageSize 260
skinparam dpi 140
title Figura 71. Diagrama 6.15.5: Secuencia — CUS-005: Postular al rol de estudiante\nmentor
actor "Estudiante postulante" as actor
boundary "Interfaz de CUS-005" as ui
control "profile_service" as svc
actor -> ui : Postular al rol de estudiante mentor
ui -> svc : Perfil, preferencia de rol y disponibilidad
activate svc
alt Reglas y autorización aplicables satisfechas
database "Persistencia o respaldo de desarrollo" as db
svc -> db : Guardar perfil y reemplazar franjas
db --> svc : Datos / resultado
svc --> ui : Perfil, preferencia de rol y disponibilidad
else Incumplimiento o fallo
svc --> ui : Rechazo / error visible; no declarar éxito
end
deactivate svc
ui --> actor : Información y opciones del recorrido

legend bottom
PARCIAL
Parcial: sin expediente, certificación de nota 14 ni envío a comité; preferencia no concede
privilegios.
endlegend

@enduml
