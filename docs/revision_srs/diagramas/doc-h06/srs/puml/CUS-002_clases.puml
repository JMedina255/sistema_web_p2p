@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #1C2A59
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam maxMessageSize 260
skinparam dpi 140
title Figura 98. Diagrama 6.16.7: Clases del dominio — CUS-002: Consultar catálogo de\nmentorías con recomendación
entity "perfiles_academicos" as perfiles_academicos {
  id_perfil : Integer <<PK>>
  email : String(255)
}
entity "disponibilidades_horarias" as disponibilidades_horarias {
  id_disponibilidad : Integer <<PK>>
  email : String(255)
}
entity "sesiones_mentoria" as sesiones_mentoria {
  id_sesion : Integer <<PK>>
  mentor_email : String(255)
  id_asignatura : Integer
  id_tema : Integer
  fecha_inicio : DateTime(UTC)
  estado : String(30)
}
legend bottom
IMPLEMENTADO; validación según alcance
Sin medición nueva de precisión ni rendimiento; contacto no acredita mensajería.
endlegend

@enduml
