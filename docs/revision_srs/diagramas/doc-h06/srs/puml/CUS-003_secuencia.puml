@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #1C2A59
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam maxMessageSize 260
skinparam dpi 140
title Figura 74. Diagrama 6.15.8: Secuencia — CUS-003: Reservar cupo para sesión de\nmentoría
actor "Estudiante mentoreado" as actor
boundary "Interfaz de CUS-003" as ui
control "booking_service" as svc
actor -> ui : Reservar cupo para sesión de mentoría
ui -> svc : Reserva provisional y control concurrente de cupo
activate svc
alt Reglas y autorización aplicables satisfechas
database "Persistencia o respaldo de desarrollo" as db
svc -> db : Bloquear sesión y crear reserva provisional
db --> svc : Datos / resultado
svc --> ui : Reserva provisional y control concurrente de cupo
else Incumplimiento o fallo
svc --> ui : Rechazo / error visible; no declarar éxito
end
deactivate svc
ui --> actor : Información y opciones del recorrido

legend bottom
IMPLEMENTADO; validación según alcance
La reserva no confirma la sesión ni registra asistencia.
endlegend

@enduml
