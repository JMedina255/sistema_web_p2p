@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #1C2A59
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam maxMessageSize 260
skinparam dpi 140
title Figura 80. Diagrama 6.15.14: Secuencia — CUS-013: Consultar historial académico\nde mentorías
actor "Estudiante / Mentor" as actor
boundary "Interfaz de CUS-013" as ui
control "booking_service / offer_service" as svc
actor -> ui : Consultar historial académico de mentorías
ui -> svc : Historial por rol de reservas y sesiones
activate svc
alt Reglas y autorización aplicables satisfechas
database "Persistencia o respaldo de desarrollo" as db
svc -> db : Consultar reservas o sesiones según rol
db --> svc : Datos / resultado
svc --> ui : Historial por rol de reservas y sesiones
else Incumplimiento o fallo
svc --> ui : Rechazo / error visible; no declarar éxito
end
deactivate svc
ui --> actor : Información y opciones del recorrido

legend bottom
PARCIAL
Parcial: historial unificado, recursos y consulta de bitácoras por mentoreado pendientes.
endlegend

@enduml
