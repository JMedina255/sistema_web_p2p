@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #1C2A59
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam maxMessageSize 260
skinparam dpi 140
title Figura 108. Diagrama 6.16.17: Clases del dominio — CUS-019: Consultar bitácoras\nde mentoría por tutor
entity "bitacoras_pedagogicas" as bitacoras_pedagogicas {
  id_bitacora : Integer <<PK>>
  id_sesion : Integer
  id_mentor : String(255)
  horas_declaradas : Float
  visado_administrador : Boolean
}
entity "sesiones_mentoria" as sesiones_mentoria {
  id_sesion : Integer <<PK>>
  mentor_email : String(255)
  id_asignatura : Integer
  id_tema : Integer
  fecha_inicio : DateTime(UTC)
  estado : String(30)
}
sesiones_mentoria ||--o| bitacoras_pedagogicas : id_sesion
legend bottom
PARCIAL
Parcial: Tutor no identificado como rol operativo; visado administrativo no constituye firma
certificada.
endlegend

@enduml
