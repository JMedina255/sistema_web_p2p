@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #1C2A59
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam maxMessageSize 260
skinparam dpi 140
title Figura 77. Diagrama 6.15.11: Secuencia — CUS-024: Cancelar reserva de cupo por\nestudiante
actor "Estudiante mentoreado" as actor
boundary "Interfaz de CUS-024" as ui
control "booking_service" as svc
actor -> ui : Cancelar reserva de cupo por estudiante
ui -> svc : Cancelación voluntaria y liberación de cupo
activate svc
alt Reglas y autorización aplicables satisfechas
database "Persistencia o respaldo de desarrollo" as db
svc -> db : Cancelar reserva y liberar cupo
db --> svc : Datos / resultado
svc --> ui : Cancelación voluntaria y liberación de cupo
else Incumplimiento o fallo
svc --> ui : Rechazo / error visible; no declarar éxito
end
deactivate svc
ui --> actor : Información y opciones del recorrido

legend bottom
IMPLEMENTADO; validación según alcance
Antes de T-24h; motivo opcional, distinto de justificación posterior de inasistencia.
endlegend

@enduml
