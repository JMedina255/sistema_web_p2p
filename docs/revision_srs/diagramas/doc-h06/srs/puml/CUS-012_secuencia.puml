@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #1C2A59
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam maxMessageSize 260
skinparam dpi 140
title Figura 79. Diagrama 6.15.13: Secuencia — CUS-012: Registrar calificación y\nfeedback bidireccional
actor "Asistente / Mentor" as actor
boundary "Interfaz de CUS-012" as ui
control "survey_service / bitacora_service" as svc
actor -> ui : Registrar calificación y feedback bidireccional
ui -> svc : Encuesta individual y observación grupal en bitácora
activate svc
alt Reglas y autorización aplicables satisfechas
database "Persistencia o respaldo de desarrollo" as db
svc -> db : Crear encuesta del asistente o registrar observación\ngrupal
db --> svc : Datos / resultado
svc --> ui : Encuesta individual y observación grupal en bitácora
else Incumplimiento o fallo
svc --> ui : Rechazo / error visible; no declarar éxito
end
deactivate svc
ui --> actor : Información y opciones del recorrido

legend bottom
PARCIAL
Parcial: no existe evidencia de evaluación individual mentor a estudiante.
endlegend

@enduml
