@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #1C2A59
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam maxMessageSize 260
skinparam dpi 140
title Figura 90. Diagrama 6.15.24: Secuencia — CUS-022: Configurar parámetros de corte\ny penalización
actor "Administrador" as actor
boundary "Interfaz de CUS-022" as ui
control "Servicio previsto" as svc
