@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #1C2A59
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam maxMessageSize 260
skinparam dpi 140
title Figura 81. Diagrama 6.15.15: Secuencia — CUS-014: Emitir constancia de horas de\nmentoría
actor "Mentor / Administrador" as actor
boundary "Interfaz de CUS-014" as ui
control "certificate_service" as svc
actor -> ui : Emitir constancia de horas de mentoría
ui -> svc : Constancia PDF DEMO y verificación por folio
activate svc
alt Reglas y autorización aplicables satisfechas
database "Persistencia o respaldo de desarrollo" as db
svc -> db : Consultar horas visadas; registrar folio de constancia
db --> svc : Datos / resultado
svc --> ui : Constancia PDF DEMO y verificación por folio
else Incumplimiento o fallo
svc --> ui : Rechazo / error visible; no declarar éxito
end
deactivate svc
ui --> actor : Información y opciones del recorrido

legend bottom
IMPLEMENTADO; validación según alcance
La ruta de emisión existe; no acredita autorización, firma ni validez institucional.
endlegend

@enduml
