@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #1C2A59
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam maxMessageSize 260
skinparam dpi 140
title Figura 24. Diagrama 6.13.8: ECB — CUS-003: Reservar cupo para sesión de mentoría
left to right direction
actor "Estudiante mentoreado" as actor
boundary "Interfaz de CUS-003" as ui
control "booking_service" as control
actor --> ui
ui --> control : Reserva provisional y control\nconcurrente de cupo
entity "reservas_cupo" as e0
control --> e0
entity "sesiones_mentoria" as e1
control --> e1

legend bottom
IMPLEMENTADO; validación según alcance
La reserva no confirma la sesión ni registra asistencia.
endlegend

@enduml
