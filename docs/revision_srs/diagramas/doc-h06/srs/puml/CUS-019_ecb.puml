ui --> control : Consulta, visado y observación\nadministrativa
entity "bitacoras_pedagogicas" as e0
control --> e0
entity "sesiones_mentoria" as e1
control --> e1

legend bottom
PARCIAL
Parcial: Tutor no identificado como rol operativo; visado administrativo no constituye firma
certificada.
endlegend

