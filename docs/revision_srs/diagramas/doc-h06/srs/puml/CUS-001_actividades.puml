/'
  Diagrama: Diagrama de Actividades — CUS-001: Iniciar sesión institucional con 2FA
  Proyecto: Sistema Web P2P de Mentorías Académicas — EPIS-UPT
  Estándar: UML 2.5
'/
@startuml
title CUS-001 — Iniciar sesión institucional con 2FA
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam fontSize 11
skinparam defaultTextAlignment center

skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #1C2A59
  BorderThickness 1.2
  FontColor #1C2A59
  ArrowColor #1C2A59
  ArrowFontColor #1C2A59
  ArrowFontSize 10
}

skinparam activityDiamond {
  BackgroundColor #FEF9C3
  BorderColor #B99451
  FontColor #1C2A59
  FontSize 10
}

skinparam swimlane {
  BorderColor #1C2A59
  BorderThickness 1.5
  TitleBackgroundColor #1C2A59
  TitleFontColor #FFFFFF
  TitleFontSize 12
}

|Usuario|
start
:Accede al sistema y selecciona\n«Iniciar sesión»;
|Sistema Web P2P|
(I)
:Muestra acceso por correo institucional y,\nsi está disponible, botón oficial de Google;
|Usuario|
if (¿Selecciona Google?) then (Sí [A001])
  :Elige una cuenta en Google;
  |Sistema Web P2P|
  :Valida identidad y dominio institucional;
  note right
    Validación con cuenta real pendiente.
  end note
  if (¿Cuenta institucional válida?) then (Sí)
    (C)
    detach
  else (No)
    :Muestra rechazo por dominio [E001];
    (I)
    detach
  endif
else (OTP)
  |Usuario|
  :Ingresa el correo y presiona\n«Continuar con Código OTP →»;
  |Sistema Web P2P|
  if (¿Formato y dominio válidos?) then (No)
    :Muestra el error de correo [E001];
    (I)
    detach
  endif
  if (¿Solicitud admitida y correo enviado?) then (No)
    :Informa fallo, espera o indisponibilidad\n[E002 / E006 / E008];
    stop
  endif
  :Emite código de 6 dígitos por 5 minutos;
  :Muestra destino, contador 05:00,\n«Cambiar correo», reenvío y «Cancelar»;
  |Usuario|
  if (¿Cambia correo o cancela?) then (Sí [A004])
    |Sistema Web P2P|
    :Descarta el formulario visible;
    (I)
    detach
  else (No)
    |Usuario|
    (V)
    if (¿Solicita reenvío habilitado?) then (Sí [A002])
      (R)
      detach
    else (No)
      :Ingresa 6 dígitos y presiona\n«Verificar y Acceder»;
      |Sistema Web P2P|
      if (¿Código vigente?) then (No [E004])
        (E)
        detach
      else (Sí)
        if (¿Código correcto?) then (Sí)
          (C)
          detach
        else (No)
          if (¿Quinto intento fallido?) then (Sí [E005])
            :Bloquea el desafío y solicita un código nuevo;
            (I)
            detach
          else (No [E003])
            :Muestra error e intentos restantes;
            (V)
            detach
          endif
        endif
      endif
    endif
  endif
endif

|Sistema Web P2P|
(E)
:Informa expiración y ofrece el reenvío;
|Usuario|
:Solicita un código nuevo;
(R)
detach

|Sistema Web P2P|
(R)
:Invalida el código anterior, emite otro\ny reinicia los contadores [A002];
(V)
detach

|Sistema Web P2P|
(C)
if (¿Consentimiento vigente?) then (Sí [A003])
else (No)
  :Muestra «Consentimiento Informado Digital»;
  |Usuario|
  if (¿Acepta el tratamiento de datos?) then (No)
    :Presiona «Rechazar y Salir»;
    |Sistema Web P2P|
    :Cierra la sesión y vuelve al acceso [E007];
    stop
  else (Sí)
    |Usuario|
    :Marca la casilla y presiona\n«Aceptar y Continuar»;
    |Sistema Web P2P|
    :Registra versión y fecha del consentimiento;
  endif
endif
|Sistema Web P2P|
:Emite sesión con vigencia máxima de 8 horas;
:Abre el panel inicial del rol y muestra\n«Cerrar Sesión»;
|Usuario|
if (¿Cierra la sesión?) then (Sí [A005])
  :Presiona «Cerrar Sesión»;
  |Sistema Web P2P|
  :Elimina la sesión del navegador y retorna al acceso;
else (No)
  |Sistema Web P2P|
  :Mantiene el acceso mientras la sesión es válida;
endif
stop
legend bottom
  Los círculos con la misma letra enlazan tramos del flujo.
endlegend

legend bottom
IMPLEMENTADO; validación según alcance
Objetos: auth_challenges, auth_rate_limits, consentimientos_legales
SMTP y Google externos requieren validación; OTP por correo o SSO no acreditan dos factores
independientes.
endlegend
