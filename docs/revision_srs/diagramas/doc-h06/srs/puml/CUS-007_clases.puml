@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #1C2A59
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam maxMessageSize 260
skinparam dpi 140
title Figura 103. Diagrama 6.16.12: Clases del dominio — CUS-007: Registrar asistencia\ny bitácora pedagógica
entity "asistencias_sesion" as asistencias_sesion {
  id_asistencia : Integer <<PK>>
  id_sesion : Integer
  estudiante_email : String(255)
}
entity "tokens_asistencia_activos" as tokens_asistencia_activos {
  id_token : Integer <<PK>>
  id_sesion : Integer
}
entity "bitacoras_pedagogicas" as bitacoras_pedagogicas {
  id_bitacora : Integer <<PK>>
  id_sesion : Integer
  id_mentor : String(255)
  horas_declaradas : Float
  visado_administrador : Boolean
}
entity "sesiones_mentoria" as sesiones_mentoria {
  id_sesion : Integer <<PK>>
  mentor_email : String(255)
  id_asignatura : Integer
  id_tema : Integer
  fecha_inicio : DateTime(UTC)
  estado : String(30)
}
sesiones_mentoria ||--o{ asistencias_sesion : id_sesion
sesiones_mentoria ||--o| tokens_asistencia_activos : id_sesion
sesiones_mentoria ||--o| bitacoras_pedagogicas : id_sesion
legend bottom
IMPLEMENTADO; validación según alcance
Cámara real pendiente; token aleatorio de 30 s, no TOTP RFC 6238; SHA-256 no equivale a firma
certificada.
endlegend

@enduml
