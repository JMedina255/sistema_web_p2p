# ==============================================================================
# Configuración del Entorno de Staging — Backend FastAPI
# Sistema Web P2P — Mentorías Académicas EPIS-UPT (REL-P2P-02)
# ==============================================================================

# Identificación de Entorno (Excluye terminantemente 'production')
APP_ENV=staging
STAGE=staging
PROJECT_NAME="Sistema Web P2P - EPIS UPT [STAGING]"
API_V1_STR=/api/v1

# Orígenes Permitidos CORS para Staging
BACKEND_CORS_ORIGINS=["https://staging.p2p.epis-upt.pe","http://localhost:5173","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Persistencia Relacional PostgreSQL (Instancia Dedicada de Staging)
# ------------------------------------------------------------------------------
# La URL de Staging DEBE apuntar a un proyecto/instancia independiente de producción.
DATABASE_URL="postgresql+psycopg://postgres.STAGING_PROJECT_REF:<GENERATE_SECURE_STAGING_DB_PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# URL exclusiva para pruebas de QA/regresión en Staging (independiente de la BD productiva)
QA_DATABASE_URL="postgresql+psycopg://qa_runner.QA_PROJECT_REF:<GENERATE_SECURE_QA_DB_PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

DB_CONNECT_TIMEOUT=5

# Modo de Persistencia Estricto (Prohíbe degradación a RAM o SQLite en Staging)
STRICT_DATABASE_MODE=true

# ------------------------------------------------------------------------------
# Autenticación y Seguridad Criptográfica (Secretos Independientes de Staging)
# ------------------------------------------------------------------------------
# Clave JWT de alta entropía (mínimo 32 caracteres criptográficamente seguros)
JWT_SECRET_KEY="<GENERATE_SECURE_RANDOM_SECRET_MIN_32_CHARS>"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# TOTP y Retos OTP según RNF01, CUS01 y directiva institucional
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60
MAX_OTP_ATTEMPTS=5
OTP_RATE_LIMIT_PER_MINUTE=5
ENABLE_MOCK_OTP_HINTS=false

# Google OAuth 2.0 (Credenciales exclusivas de Staging)
GOOGLE_CLIENT_ID="STAGING_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# Notificaciones por Correo Electrónico (Servicio SMTP de Staging)
# ------------------------------------------------------------------------------
# Mantener deshabilitado (false) hasta contar con credenciales y buzón de pruebas acreditado
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER="notificaciones.staging@upt.pe"
SMTP_PASSWORD="<GENERATE_SECURE_SMTP_APP_PASSWORD_OR_KEEP_DISABLED>"
SMTP_FROM_EMAIL="notificaciones.staging@upt.pe"
SMTP_FROM_NAME="Mentorías Académicas EPIS-UPT [Staging]"
