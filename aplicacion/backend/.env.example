# ==============================================================================
# Sistema Web P2P de Mentorías Universitarias - EPIS UPT
# Plantilla de Configuración de Variables de Entorno (Backend)
# ==============================================================================

# Entorno de ejecución: 'development' | 'production' | 'test'
APP_ENV=development
PROJECT_NAME="Sistema Web P2P - EPIS UPT"
API_V1_STR=/api/v1

# Orígenes CORS autorizados para la SPA de React (formato lista JSON)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ------------------------------------------------------------------------------
# 1. Base de Datos Relacional (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Cadena de conexión con dialecto psycopg 3 (postgresql+psycopg:// o postgresql://)
DATABASE_URL="postgresql+psycopg://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@POOLER_HOST:5432/postgres?sslmode=require"
DB_CONNECT_TIMEOUT=5

# ------------------------------------------------------------------------------
# 2. Seguridad, Criptografía y Tokens JWT (RNF01 / RNF02)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=clave_secreta_super_segura_p2p_epis_upt_2026_dev
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------------------
# 3. Concurrencia, Bloqueo Pesimista y Quórum Normativo (RN-04 / RN-05 / RN-08 / RN-09)
# ------------------------------------------------------------------------------
BOOKING_TIMEOUT_SECONDS=5
QUORUM_MINIMUM_PERCENTAGE=50
QUORUM_CUTOFF_HOURS=24
ENABLE_CONCURRENCY_STRESS_TEST=false

# ------------------------------------------------------------------------------
# 4. Servicio de Correo Electrónico (SMTP para OTP y Alertas - Compatible con Google/Gmail)
# ------------------------------------------------------------------------------
# Si SMTP_ENABLED=false o SMTP_USER está vacío, los correos se registran en la
# consola del servidor [EMAIL DEV/MOCK] con fines de desarrollo y pruebas.
#
# Para activar envíos reales con tu cuenta de Gmail:
# 1. Ve a tu cuenta Google -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones.
# 2. Crea una contraseña para "Sistema Mentorias" (código de 16 caracteres, ej: abcd efgh ijkl mnop).
# 3. Coloca SMTP_ENABLED=true y tus datos:
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=noreply.mentoria.upt@gmail.com
SMTP_FROM_NAME="Sistema de Mentorías EPIS-UPT"

# ------------------------------------------------------------------------------
# 5. Almacenamiento Híbrido de Archivos (Storage: Local y Supabase)
# ------------------------------------------------------------------------------
# STORAGE_BACKEND: 'local' (guarda en disco en uploads/) | 'supabase' (Supabase Storage API)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=uploads
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET_CERTIFICATES=certificados
SUPABASE_BUCKET_RESOURCES=recursos
ENABLE_DEMO_WATERMARK=false

# ------------------------------------------------------------------------------
# 6. Planificador en Segundo Plano (Scheduler para Quórum a T-24h)
# ------------------------------------------------------------------------------
ENABLE_BACKGROUND_SCHEDULER=true
SCHEDULER_INTERVAL_MINUTES=15
