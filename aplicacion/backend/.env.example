APP_ENV=development
PROJECT_NAME="Sistema Web P2P - EPIS UPT"
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Cadena de conexión a PostgreSQL (Supabase Session Pooler con dialecto psycopg 3)
DATABASE_URL="postgresql+psycopg://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@POOLER_HOST:5432/postgres?sslmode=require"
DB_CONNECT_TIMEOUT=5
