# ==============================================================================
# Configuración del Entorno de Staging — Frontend React + Vite
# Sistema Web P2P — Mentorías Académicas EPIS-UPT (REL-P2P-02)
# ==============================================================================

# URL Base del API Backend de Staging (Raíz del backend, SIN prefijo /api/v1 ya que los adaptadores lo incorporan)
VITE_API_BASE_URL=https://api-staging.p2p.epis-upt.pe

# Modo Operativo del Frontend: 'api' para conexión real con FastAPI
VITE_SERVICE_MODE=api

# Bloqueo Estricto de Modo Mock en Staging (Impide degradación o cambio manual a mock)
VITE_DISABLE_MOCK_MODE=true

# Identificación de Entorno
VITE_APP_ENV=staging
VITE_STAGE=staging

# Credencial de Google OAuth 2.0 (Aplicación web autorizada para staging)
VITE_GOOGLE_CLIENT_ID=STAGING_GOOGLE_CLIENT_ID.apps.googleusercontent.com
