# ==============================================================================
# Variables de Entorno - Frontend React (EPIS-UPT Sistema Web P2P)
# ==============================================================================

# URL base de la API REST FastAPI del backend local
VITE_API_BASE_URL=http://localhost:8000

# Modo de operación de servicios:
# - 'api'  : Conexión HTTP directa con el backend FastAPI local (Recomendado para operación real).
# - 'mock' : Modo desacoplado de desarrollo/pruebas visuales aisladas sin backend activo.
VITE_SERVICE_MODE=api
